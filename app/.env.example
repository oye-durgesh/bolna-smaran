# Copy to app/.env.local for local development. NEVER commit a real .env file.
# Everything here is PUBLIC (shipped to the browser). Private provider keys live only in Supabase function secrets
# (see supabase/.env.example).

# Leave both blank to run without accounts. Use "Try a sample prescription (DEMO DATA)" for labelled sample medicines.
# A real file upload needs VITE_SUPABASE_* plus a signed-in session (or VITE_LOCAL_API with npm run dev:api).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push public key (npx web-push generate-vapid-keys). Needed for reminders to arrive when the app is closed.
VITE_VAPID_PUBLIC_KEY=

# Set to true ONLY while running `npm run dev:api` (local server that holds the Sarvam/ElevenLabs keys). Not a secret.
VITE_LOCAL_API=

# Shown behind "Contact support" in Help. Leave blank to hide the action.
VITE_SUPPORT_EMAIL=
