# Function SECRETS. Set with:  supabase secrets set --env-file supabase/.env.local
# NEVER commit supabase/.env.local, and never put any of these in app/.env*.

# Scheduler
CRON_SECRET=
VAPID_PUBLIC_KEY=                 # npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Sarvam Document Intelligence Extract (prescription reading)
SARVAM_API_KEY=
# SARVAM_DOC_JOB_PATH=extract   # default; only set to parse if an old account still uses Parse

# ElevenLabs
ELEVENLABS_API_KEY=
MUMMY_ELEVENLABS_AGENT_ID=         # Mummy's agent (ElevenLabs dashboard). Not secret, but kept server-side
PAPA_ELEVENLABS_AGENT_ID=          # Papa's agent. Must differ from Mummy's
ELEVENLABS_VOICE_ID=              # optional default/self voice. Mummy/Papa TTS uses each agent's Voice setting, not these
# Do not put Agent IDs in the lines below. They are unused for reminder TTS.
ELEVENLABS_MOM_VOICE_ID=
ELEVENLABS_DAD_VOICE_ID=
ELEVENLABS_AGENT_USES_CLONED_VOICE=false   # true only if the agents use cloned voices
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# CORS: set to your deployed app origin in production
ALLOWED_ORIGIN=*
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are provided to functions automatically.
