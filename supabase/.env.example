# Function SECRETS. Set with:  supabase secrets set --env-file supabase/.env.local
# NEVER commit supabase/.env.local, and never put any of these in app/.env*.

# Scheduler
CRON_SECRET=                      # long random string; also set as app.settings.cron_secret in Postgres (see README)
VAPID_PUBLIC_KEY=                 # npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Sarvam Document AI (prescription reading)
SARVAM_API_KEY=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=              # a private agent created in the ElevenLabs dashboard (live conversation, beta)
ELEVENLABS_VOICE_ID=              # default, non-cloned voice (used when neither Mom nor Dad is selected)
ELEVENLABS_MOM_VOICE_ID=          # a voice you own / have written permission to use. Used ONLY when "Mom" is selected, and only after consent
ELEVENLABS_DAD_VOICE_ID=          # same, for "Dad / Papa". A missing ID is an error - it never falls back to another voice
ELEVENLABS_AGENT_USES_CLONED_VOICE=false
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# CORS: set to your deployed app origin in production
ALLOWED_ORIGIN=*
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are provided to functions automatically.
